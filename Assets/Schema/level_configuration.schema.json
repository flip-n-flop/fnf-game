{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://JEDCIRCUITOS/Assets/Schema/level_configuration.schema.json",
    "title": "Esquema de Nível de Jogo",
    "description": "Define a estrutura de um arquivo JSON de configuração de nível.",
    "type": "object",
    "properties": {
        "levelName": {
            "type": "string",
            "description": "O nome descritivo do nível (formato: 'level_n')."
        },
        "levelDescription": {
            "type": "string",
            "description": "Descrição detalhada do nível."
        },
        "levelID": {
            "type": "string",
            "description": "ID para identificação de ordenação de fases."
        },
        "levelOrder": {
          	"type": "integer",
            "description": "Define um número inteiro de encaixe para a ordenação de disposição de fases."
        },
       	"ffType": {
          	"type": "string",
            "enum": ["JK", "SR", "T", "D"],
            "description": "Define qual o tipo do flip flop desta fase"
        },
        "clockCicles": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantidade de ciclos de clock na fase."
        },
        "activeClockEdge": {
            "type": "string",
            "enum": ["rising", "falling"],
            "description": "Define se o sinal responde à borda de subida ou descida."
        },
        "jSignal": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para o J (sequência de 1s e 0s)."
        },
        "kSignal": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para o K (sequência de 1s e 0s)."
        },
        "presetSignal": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para sinal assíncrono Preset (sequência de 1s e 0s)."
        },
        "clearSignal": {
          	"type": "string",
            "pattern": "^[01 ]+$",
            "description": "Sequência binária para sinal assíncrono Clear (sequência de 1s e 0s)."
        },
        "asyncActive": {
            "type": "string",
            "enum": ["high", "low"],
            "description": "Define se sinais assíncronos estão ativos em 1 ou em 0."
        },
        "floor": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Representação binária do chão"
        },
        "ceiling": {
            "type": "string",
            "pattern": "^[01 ]+$",
            "description": "Representação binária do teto"
        },
        "obstacles": {
            "type": "array",
            "description": "Lista de configurações para geração de diferentes obstáculos.",
            "items": {
                "type": "object",
                "properties": {
                    "obstacleName": {
                        "type": "string",
                        "description": "Nome/ID do obstáculo a ser gerado.",
                        "enum": [
                            "Rock",
                            "Mace",
                            "Rat",
                            "SewerRat",
                            "Button",
                            "Wall",
                            "SpikeTrap",
                            "MovingPlatform"
                        ]
                    },
                    "startX": { "type": "number" },
                    "startY": { "type": "number" },
                    "speed": { "type": "number"},
                    "horizontalDistance": { "type": "number" },
                    "verticalDistance": { "type": "number" },
                    "starterCorner": { "type": "string" },
                    "clockwise": { "type": "boolean" }
                },
                "required": [
                    "obstacleName",
                    "startX",
                    "startY"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "levelName",
      	"levelDescription",
		"ffType",
        "clockCicles",
        "activeClockEdge",
        "floor",
        "ceiling",
        "obstacles"
    ],
    "dependencies": {
    	"presetSignal": ["asyncActive"],
        "clearSignal": ["asyncActive"]
    },
    "allOf": [
      {
      	"if": {
          "properties": { "ffType": { "const": "JK" } }
        },
        "then": {
          "required": ["jSignal", "kSignal"]
        },
        "else": {
            "properties": {
                "jSignal": false,
                "kSignal": false
            }
        }
      },
      {
        "if": { "required": ["asyncActive"] },
        "then": {
          "anyOf": [
            { "required": ["presetSignal"] },
            { "required": ["clearSignal"] }
          ]
        }
      }
    ],
    "additionalProperties": false
}
