:root {
    -unity-font-definition: url("../../TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf");
}

.screen,
.flip-screen {
    width: 1300px;
    height: 691px;
    flex-grow: 1;
    flex-shrink: 0;
    background-color: #071022;
}

.bg-main {
    background-image: url("../../Arts/Background.jpeg");
}

.overlay,
.screen-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(5, 10, 24, 0.4);
}

.panel,
.screen-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    padding-top: 32px;
    padding-right: 48px;
    padding-bottom: 32px;
    padding-left: 48px;
}

.card,
.menu-card {
    align-items: center;
    justify-content: center;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
}

.menu-card-small {
    width: 400px;
}

.page,
.content-card {
    width: 80%;
    max-width: 768px;
    height: 80%;
    padding: 24px;
    background-color: rgba(14, 23, 52, 1);
    border-radius: 16px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(54, 229, 255, 0.8);
    border-right-color: rgba(54, 229, 255, 0.8);
    border-top-color: rgba(54, 229, 255, 0.8);
    border-bottom-color: rgba(54, 229, 255, 0.8);
}

.config-content-card {
    width: 780px;
    max-width: 780px;
    height: 560px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(14, 23, 52, 0.96);
}

.howToPlay-page {
    padding-bottom: 128px;
}

.about-page {
    padding-bottom: 96px;
}

.btn,
.menu-button,
.secondary-button {
    height: 64px;
    background-color: #1C2B5C;
    color: #F5F7FA;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #FFB347;
    border-right-color: #FFB347;
    border-top-color: #FFB347;
    border-bottom-color: #FFB347;
    border-radius: 16px;
    font-size: 24px;
    -unity-font-style: bold;
}

.btn:hover,
.btn:focus,
.menu-button:hover,
.menu-button:focus,
.secondary-button:hover,
.secondary-button:focus {
    background-color: #2F5BFF;
}

.btn,
.menu-button {
    width: 100%;
    margin-bottom: 8px;
}

.back,
.secondary-button {
    width: 120px;
    position: absolute;
    left: 24px;
    bottom: 24px;
}

.title,
.section-title {
    width: 100%;
    color: #F5F7FA;
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 24px;
}

.subtitle {
    width: 100%;
    color: #F5F7FA;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 10px;
    margin-bottom: 24px;
}

.credits,
.credits-list {
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 16, 34, 0.7);
    margin-right: -4px;
}

.text,
.about-text {
    width: 100%;
    color: #F5F7FA;
    font-size: 28px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.grid,
.level-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
}

.level,
.level-button {
    width: 96px;
    height: 96px;
    margin: 16px;
    background-color: #1C2B5C;
    color: #F5F7FA;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #36E5FF;
    border-right-color: #36E5FF;
    border-top-color: #36E5FF;
    border-bottom-color: #36E5FF;
    font-size: 34px;
    -unity-font-style: bold;
}

.level:hover,
.level:focus,
.level-button:hover,
.level-button:focus {
    background-color: #2F5BFF;
    border-left-color: #FFB347;
    border-right-color: #FFB347;
    border-top-color: #FFB347;
    border-bottom-color: #FFB347;
}

.scroll,
.howToPlay-scroll {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 0;
    background-color: rgba(7, 16, 34, 0.7);
    padding-top: 20px;
    padding-right: 22px;
    padding-bottom: 20px;
    padding-left: 22px;
}

.howToPlay-item,
.howToPlay-row {
    flex-direction: column;
    min-height: 0;
    margin-bottom: 18px;
    padding-top: 16px;
    padding-right: 18px;
    padding-bottom: 16px;
    padding-left: 18px;
    background-color: rgba(28, 43, 92, 0.72);
}

.image-slot,
.howToPlay-image-slot {
    display: none;
}

.howToPlay-text {
    width: 100%;
    white-space: normal;
    font-size: 23px;
    color: #F5F7FA;
}

/* ── HUD Hexagonal Menu Button (Bottom-Right) ── */

.hud-menu-button {
    position: absolute;
    bottom: 24px;
    right: 56px;
    width: 76px;
    height: 76px;
    scale: 0.9 0.9;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    align-items: center;
    justify-content: center;
}

.hud-menu-button:hover,
.hud-menu-button:focus,
.hud-menu-button:active {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* Sombra: Fundo do botão (estática e mais próxima da box) */
.hud-menu-btn-shadow {
    position: absolute;
    width: 64px;
    height: 64px;
    top: 2px;
    left: 8px;
    background-image: url("project://database/Assets/Arts/InGameUI/Bot%C3%B5es/Sombra.png?fileID=-114595351847970599&guid=c6e3048f710863c47a326db6c3497be5&type=3#Sombra_0");
    -unity-background-scale-mode: scale-to-fit;
}

/* Caixa: No normal fica reta em 0° e branca (#FFFFFF) */
.hud-menu-btn-box {
    position: absolute;
    width: 72px;
    height: 70px;
    top: 0;
    left: 0;
    background-image: url("project://database/Assets/Arts/InGameUI/Bot%C3%B5es/Caixa.png?fileID=-860264664590275695&guid=3e7c5d6572b489d4f8c9ff09731886e3&type=3#Caixa_0");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
    rotate: 0deg;
    translate: 0 0;
    scale: 1 1;
    transform-origin: 45% 40%;
    transition-property: rotate, -unity-background-image-tint-color, scale, translate;
    transition-duration: 0.25s, 0.25s, 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.hud-controls-button {
    right: 124px;
    bottom: 36px;
}

/* Ícone de Configurações: Centralizado na face do hexágono (gira junto com a box) */
.hud-menu-btn-icon {
    position: absolute;
    width: 50%;
    height: 50%;
    left: 44%;
    top: 38%;
    translate: -50% -50%;
    background-image: url("project://database/Assets/Arts/InGameUI/Bot%C3%B5es/%C3%8Dcone_Configura%C3%A7%C3%B5es.png?fileID=-3148450962777015629&guid=3034eae473042f242b24b5fecd3cb983&type=3#%C3%8Dcone_Configura%C3%A7%C3%B5es_0");
    -unity-background-scale-mode: scale-to-fit;
}

/* Ícone de Controles: substitui apenas a textura */
.hud-icon-controls {
    background-image: url("project://database/Assets/Arts/InGameUI/Bot%C3%B5es/%C3%8Dcone_Controles.png?fileID=192893356250108789&guid=a1f8aa4af19b9644889182691fd2a478&type=3#%C3%8Dcone_Controles_0");
}

/* Badge ESC: Tecla SVG do teclado dentro da box, na aba preta */
.hud-menu-btn-esc {
    position: absolute;
    width: 17px;
    height: 17px;
    left: 76%;
    top: 78%;
    translate: -50% -50%;
    background-image: url("../../Arts/Keyboard/keyboard_escape_outline.svg");
    -unity-background-scale-mode: scale-to-fit;
}

/* Badge TAB: substitui a textura e ajusta levemente a largura */
.hud-badge-tab {
    width: 19px;
    background-image: url("../../Arts/Keyboard/keyboard_tab_outline.svg");
}

/* ── Efeitos de Hover e Clique (apenas na box) ── */

/* Hover: Cresce um pouco, anda para esquerda e cima (-3px -3px), gira ~30° anti-horário e fica roxo */
.hud-menu-button:hover .hud-menu-btn-box {
    rotate: -8deg;
    -unity-background-image-tint-color: #C772CA;
    scale: 1.08 1.08;
    translate: -2px -2px;
}

/* Active: Leve recuo ao clicar */
.hud-menu-button:active .hud-menu-btn-box {
    rotate: -15deg;
    scale: 0.96 0.96;
    translate: 2px 2px;
}

.game-menu-card {
    width: 320px;
    min-height: 430px;
}

.hidden {
    display: none !important;
}