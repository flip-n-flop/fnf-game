:root {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
}

/* ── HUD Root ── */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    /* No pointer events on the root so it doesn't block gameplay input */
    pointer-events: none;
}

/* ── In-Game Timer (Top-Left) ── */

.hud-timer-container {
    position: absolute;
    top: 8px;
    left: 12px;
    height: 64px;
    min-width: 120px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(30, 30, 30, 0.95);
    border-radius: 15px;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.hud-timer-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 24px;
    color: #F5F7FA;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ── Level Title (Top-Center) ── */

.hud-title-wrapper {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
}

.hud-title-container {
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.hud-title-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 28px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ── Signal HUD Labels ── */

.signal-label {
    position: absolute;
    align-items: center;
    justify-content: center;
    /* Hidden by default; script shows them when needed */
    display: none;
}

.signal-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.signal-text-wrapper {
    align-items: stretch;
    justify-content: center;
    flex-direction: column;
}

.signal-overline {
    height: 2px;
    background-color: white;
    margin-bottom: 1px;
    display: none;
}

.signal-overline.active {
    display: flex;
}

.signal-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 24px;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ── Tutorial Panel (Bottom-Center) ── */

.tutorial-container {
    position: absolute;
    bottom: 150px;
    left: 100px;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    max-width: 600px;
    min-height: 64px;
    padding: 16px 24px;
    background-color: rgba(30, 30, 30, 0.95);
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    display: none;
}

.tutorial-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 22px;
    color: #F5F7FA;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}
