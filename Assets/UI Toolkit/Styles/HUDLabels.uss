:root {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
}

/* ── HUD Root ── */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    /* No pointer events on the root so it doesn't block gameplay input */
    pointer-events: none;
}

/* ── In-Game Timer (Left Playfield Badge) ── */

.hud-timer-wrapper {
    position: absolute;
    bottom: 28%;
    left: 64px;
    align-items: flex-start;
    justify-content: center;
    pointer-events: none;
}

.hud-timer-container {
    width: 116px;
    height: 70px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Arts/InGameUI/Timer/Background.png?fileID=-1955448553306655712&guid=ea9a54eddb5cb6649ba8379ee0894ea3&type=3#Background_0");
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 0;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.hud-timer-clock {
    position: absolute;
    width: 33px;
    height: 37px;
    left: -12px;
    top: 14px;
    background-image: url("project://database/Assets/Arts/InGameUI/Timer/Clock.png?fileID=4214149858688995037&guid=b246c17d2d0c3e046a894cd50dd0dc82&type=3#Clock_0");
    -unity-background-scale-mode: scale-to-fit;
}

.hud-timer-text-group {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    rotate: -7deg;
    margin-left: 28px;
    margin-top: 2px;
}

.hud-timer-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/FS%20Industrie%20Bold%20Italic.otf?fileID=12800000&guid=2bbd195ae471f6740b804e576e15fa3c&type=3#FS Industrie Bold Italic");
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: #000000;
    padding: 0;
    margin: 0;
}

.hud-timer-digit-sec {
    width: 27px;
    font-size: 44px;
}

.hud-timer-dot {
    width: 6px;
    font-size: 38px;
    margin-bottom: 2px;
}

.hud-timer-digit-centi {
    width: 20px;
    font-size: 32px;
    margin-bottom: 2px;
}

/* ── Level Title (Bottom-Left) ── */

.hud-title-wrapper {
    position: absolute;
    bottom: 28px;
    left: 68px;
    align-items: flex-start;
    justify-content: flex-end;
    pointer-events: none;
}

.hud-title-container {
    background-color: transparent;
    border-width: 0;
    align-items: flex-start;
    justify-content: flex-end;
}

.hud-title-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/FS%20Industrie%20Bold%20Italic.otf?fileID=12800000&guid=2bbd195ae471f6740b804e576e15fa3c&type=3#FS Industrie Bold Italic");
    -unity-font-style: bold;
    font-size: 38px;
    color: #FFFFFF;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #000000;
    text-shadow: 4px 4px 0px #000000;
    letter-spacing: -2px;
}

.hud-subtitle-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/FS%20Industrie%20Italic.otf?fileID=12800000&guid=3216756f7c4a20146a30909395f0db55&type=3#FS Industrie Italic");
    font-size: 26px;
    color: #FFFFFF;
    -unity-text-align: middle-left;
    padding: 0;
    margin-top: 2px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

/* ── Signal HUD Labels ── */

.signal-label {
    position: absolute;
    align-items: center;
    justify-content: center;
    /* Hidden by default; script shows them when needed */
    display: none;
}

.signal-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.signal-text-wrapper {
    align-items: stretch;
    justify-content: center;
    flex-direction: column;
}

.signal-overline {
    height: 2px;
    background-color: white;
    margin-bottom: 1px;
    display: none;
}

.signal-overline.active {
    display: flex;
}

.signal-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 24px;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ── Tutorial Panel (Bottom-Center) ── */

.tutorial-container {
    position: absolute;
    bottom: 150px;
    left: 100px;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    max-width: 600px;
    min-height: 64px;
    padding: 16px 24px;
    background-color: rgba(30, 30, 30, 0.95);
    border-radius: 15px;
    align-items: center;
    justify-content: center;
    display: none;
}

.tutorial-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Exo2-VariableFont_wght.ttf?fileID=12800000&guid=06cc052497f62034fb43e3edf087d21a&type=3#Exo2-VariableFont_wght");
    -unity-font-style: bold;
    font-size: 22px;
    color: #F5F7FA;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}